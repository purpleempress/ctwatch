  "query": "SELECT cert_hash, issuer_hash, issuer_cn, not_before, not_after, sans, registered_domains\n           FROM certs\n           WHERE registered_domains && ARRAY[$1]::TEXT[]\n             AND not_before >= $2\n           ORDER BY not_before DESC\n           LIMIT $3",
