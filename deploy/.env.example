# Required — generate with: openssl rand -base64 32
DB_PASSWORD=

# Optional — restrict to specific CT log operators. "*" (default) tails all usable.
# Comma-separated: Google,Cloudflare,Sectigo,DigiCert,TrustAsia
LOG_OPERATORS=*

# Optional — retention windows (days).
RETENTION_DAYS_HOT=90
RETENTION_DAYS_COLD=400

# Watchlist source: db | file | url | disabled. db = CRUD via /v1/watchlist.
WATCHLIST_MODE=db
# Used when WATCHLIST_MODE=file (path inside the container, e.g. /etc/ctwatch/watchlist.yml)
WATCHLIST_FILE=
# Used when WATCHLIST_MODE=url
WATCHLIST_URL=
# Reload interval for file/url modes
WATCHLIST_REFRESH=60s

# Webhook delivery. When unset, the dispatcher stays idle.
# WEBHOOK_HMAC_SECRET is required when WEBHOOK_URL is set.
WEBHOOK_URL=
WEBHOOK_HMAC_SECRET=
WEBHOOK_MAX_ATTEMPTS=7

# Live stream WebSocket endpoint.
STREAM_ENABLED=true

LOG_LEVEL=info
